# Copy to .env.local and fill in. Never commit real values.

# Public URL of the deployed site (used for metadata, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://harshavardhan-reddy.vercel.app

# --- Contact form (required for email delivery) ---
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Where messages are delivered (defaults to the email in content/profile.ts).
CONTACT_TO_EMAIL=
# Sender. Must be on a domain verified in Resend. Without a verified domain,
# use the Resend test sender, which can only deliver to your Resend account email.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# --- Optional: GitHub (enables the contribution heatmap, raises API rate limits) ---
# Fine-grained token with no extra permissions (public data only) is enough.
GITHUB_TOKEN=

# --- Optional: shared rate limiting across serverless instances ---
# Free Redis database at https://upstash.com. Without these, an in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
